# Nano-GPT API Key — get yours at https://nano-gpt.com
NANO_GPT_API_KEY=your_api_key_here

# Optional overrides
# NANO_GPT_BASE_URL=https://api.nano-gpt.com/v1
# NANO_GPT_MODEL=xiaomi/mimo-v2.5-pro:thinking

# Which backend to use by default: "nanogpt" (cloud) or "lmstudio" (local).
# Can also be switched per-session in the Settings drawer.
# BACKEND=nanogpt

# LM Studio local server (Settings > Model Backend > LM Studio). No API key needed.
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=local-model

# Generation timeout in seconds (default 3600 = 60 min). Local models are
# usually much faster than this, but the ceiling only matters if it's hit.
# GENERATION_TIMEOUT=3600
