# Nano-GPT API Key — get yours at https://nano-gpt.com
NANO_GPT_API_KEY=your_api_key_here

# Optional overrides
# NANO_GPT_BASE_URL=https://api.nano-gpt.com/v1
# NANO_GPT_MODEL=xiaomi/mimo-v2.5-pro:thinking

# Which backend to use by default: "nanogpt" (cloud) or "lmstudio" (local).
# Can also be switched per-session in the Settings drawer. Defaults to lmstudio.
# BACKEND=lmstudio

# LM Studio local server (Settings > Model Backend > LM Studio).
# The URL is contacted server-side, so "localhost" = the machine running this app.
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Default model to request. LM Studio loads it on demand if it isn't already
# loaded (enable Just-In-Time model loading in LM Studio's server settings).
# LM_STUDIO_MODEL=rocinante-x-12b-v1
# A plain LM Studio server needs no key. Set this only if you've put your
# local server behind an API key.
# LM_STUDIO_API_KEY=your_local_key_here

# Generation timeout in seconds (default 3600 = 60 min). Local models are
# usually much faster than this, but the ceiling only matters if it's hit.
# GENERATION_TIMEOUT=3600

# Per-backend token limits. If card generation keeps getting cut off
# ("hit the N-token generation limit" error), raise GEN_MAX_TOKENS_LMSTUDIO —
# just make sure it still fits your model's context window alongside the
# system prompt and conversation history.
# CHAT_MAX_TOKENS_NANOGPT=15000
# CHAT_MAX_TOKENS_LMSTUDIO=1200
# GEN_MAX_TOKENS_NANOGPT=50000
# GEN_MAX_TOKENS_LMSTUDIO=6000
